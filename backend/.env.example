# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB Configuration
# EASY SWITCH: Comment/uncomment the line you want to use

# LOCAL MongoDB (for development)
MONGODB_URI=mongodb://localhost:27017/legaliq

# PRODUCTION MongoDB Atlas (uncomment to use)
# MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/legaliq?retryWrites=true&w=majority&appName=LegalIQ

# Instructions:
# 1. For LOCAL: Keep line 9 uncommented, comment line 12
# 2. For PRODUCTION: Comment line 9, uncomment line 12 and replace with your MongoDB Atlas connection string
# 3. Restart the server after changing

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Client URL
CLIENT_URL=http://localhost:5173

# Server URL
SERVER_URL=http://localhost:4000

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ============================================
# SMS/OTP Configuration
# ============================================

# Enable real SMS sending (set to true to send actual SMS)
# If false or not set, OTPs will only be logged to console
SMS_ENABLED=false

# SMS Provider: MSG91, TWILIO, FAST2SMS, AWS_SNS
SMS_PROVIDER=MSG91

# MSG91 Configuration (Recommended for India)
# Sign up at: https://msg91.com/
# Pricing: ₹0.15-0.25 per SMS
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=LGALIQ
MSG91_ROUTE=4
MSG91_TEMPLATE_ID=your_dlt_template_id

# Twilio Configuration (Global)
# Sign up at: https://www.twilio.com/
# Pricing: ~$0.0058 per SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Fast2SMS Configuration (India - Budget option)
# Sign up at: https://www.fast2sms.com/
FAST2SMS_API_KEY=your_fast2sms_api_key
FAST2SMS_SENDER_ID=LGALIQ

# AWS SNS Configuration
# Requires AWS account
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1

# ============================================
# Instructions for SMS Setup
# ============================================
#
# DEVELOPMENT MODE (Current):
# - SMS_ENABLED=false (or not set)
# - OTPs will be logged to console
# - Perfect for testing without SMS costs
#
# PRODUCTION MODE:
# 1. Set SMS_ENABLED=true
# 2. Choose SMS_PROVIDER (MSG91 recommended for India)
# 3. Add provider credentials above
# 4. For India: Complete DLT registration
# 5. Test with your mobile number first
#
# MSG91 Setup (Recommended):
# 1. Sign up at https://msg91.com/
# 2. Get ₹50 free credits
# 3. Copy Auth Key from dashboard
# 4. Register DLT template (mandatory for India)
# 5. Add credentials above
# 6. Set SMS_ENABLED=true
#
# DLT Registration (Required for India):
# - Register at: https://trueconnect.jio.com/
# - Create template: "Your LegalIQ OTP is <#> XXXXXX. Valid for 5 minutes."
# - Get template ID and add to MSG91_TEMPLATE_ID
#
# ============================================
# WhatsApp Notifications (MSG91)
# ============================================
# No DLT registration required for WhatsApp messages!
# DLT is only needed for SMS in India.

# Enable/disable WhatsApp notifications
WHATSAPP_ENABLED=false

# MSG91 WhatsApp Integrated Number ID
# Get from MSG91 Dashboard > WhatsApp > Settings
MSG91_WHATSAPP_INTEGRATED_NUMBER_ID=your_integrated_number_id_here

# Admin WhatsApp number (with country code, e.g., 919876543210)
ADMIN_WHATSAPP_NUMBER=919876543210

# WhatsApp Setup Instructions:
# 1. Log in to MSG91 Dashboard (https://msg91.com)
# 2. Go to WhatsApp section and enable it
# 3. Get your Integrated Number ID from WhatsApp settings
# 4. Create message templates (see WHATSAPP_INTEGRATION_GUIDE.md)
# 5. Wait for template approval from WhatsApp/Meta
# 6. Set WHATSAPP_ENABLED=true
# 7. Add your admin WhatsApp number above

# ============================================
# Document Upload Configuration
# ============================================

# Maximum file size per document (in MB)
MAX_FILE_SIZE_MB=5

# Maximum total storage per consultation (in MB)
MAX_CONSULTATION_STORAGE_MB=50
