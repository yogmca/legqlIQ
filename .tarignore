# LegalIQ Deployment Package - Files to Exclude

# Dependencies
node_modules/
backend/node_modules/

# Build outputs
dist/
build/

# Environment files (will be created during deployment)
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Testing
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp
.cache/

# Database dumps (will be handled separately)
dump/
*.dump

# PM2
.pm2/

# Misc
.eslintcache
.parcel-cache
