# Frontend Dockerfile for LegalIQ - Render Optimized
# Multi-stage build for optimized production image

# Stage 1: Build the React application
FROM node:20-alpine as build

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (production only for leaner image)
RUN npm install --production=false

# Copy application code
COPY . .

# Build the application
RUN npm run build

# Stage 2: Serve with Nginx (smaller base)
FROM nginx:alpine

# Copy built files from build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration optimized for Render
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80 (Render expects HTTP on $PORT or 8080)
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:8080/ || exit 1

# Start Nginx (Render uses PORT env var, default to 8080)
CMD ["nginx", "-g", "daemon off;"]
