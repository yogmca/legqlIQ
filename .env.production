# Production build env for single-container deployment (Render)
# Frontend and backend are served from the SAME origin behind nginx.
# nginx proxies /api -> backend (node on internal port 4000) and
# serves the built React app for everything else.
# Using a relative /api base means all API calls are same-origin (no CORS).
VITE_API_URL=/api

# Socket.IO connects to the same origin (empty = current origin)
VITE_SOCKET_URL=

VITE_RAZORPAY_KEY_ID=rzp_live_SeReYskT2db0Ut
VITE_ENABLE_WEBRTC=true
