# LegalIQ Docker Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# MongoDB Configuration
# ============================================
# For MongoDB Atlas (recommended):
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/legaliq?retryWrites=true&w=majority

# For local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/legaliq

# ============================================
# JWT Configuration
# ============================================
# Generate strong random secrets (min 32 characters)
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-change-this
JWT_EXPIRES_IN=7d

# ============================================
# Session Configuration
# ============================================
SESSION_SECRET=your-super-secret-session-key-min-32-characters-change-this

# ============================================
# Application URLs
# ============================================
# For local development:
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000/api

# For production (replace with your domain):
# CLIENT_URL=https://legaliq.com
# SERVER_URL=https://api.legaliq.com
# VITE_API_URL=https://api.legaliq.com/api

# ============================================
# Google OAuth Configuration
# ============================================
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# For local development:
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# For production:
# GOOGLE_CALLBACK_URL=https://api.legaliq.com/api/auth/google/callback

# ============================================
# Razorpay Configuration
# ============================================
# Get your keys from: https://dashboard.razorpay.com/app/keys
# Use test keys for development, live keys for production
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id-here

# ============================================
# WebRTC Configuration
# ============================================
# Set to 'true' for real peer-to-peer video, 'false' for mock/demo mode
# Use 'false' for local development, 'true' for production
VITE_ENABLE_WEBRTC=false
# WebSocket server URL (should match backend server)
VITE_SOCKET_URL=http://localhost:4000

# ============================================
# Node Environment
# ============================================
NODE_ENV=production
PORT=4000
